{
  "name": "cowrie-codec",
  "version": "2.1.2",
  "description": "Cowrie - Structured JSON binary codec for TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:coverage": "npx c8 --check-coverage --lines 80 --reporter text --reporter text-summary node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "json",
    "binary",
    "serialization",
    "codec",
    "tensor",
    "ml"
  ],
  "author": "Neumenon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neumenon/cowrie"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^26.0.0",
    "c8": "^11.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {},
  "homepage": "https://github.com/Neumenon/cowrie#readme",
  "bugs": {
    "url": "https://github.com/Neumenon/cowrie/issues"
  }
}
